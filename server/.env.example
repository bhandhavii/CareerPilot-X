PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot-x
# Generate a long random value; never commit a real secret.
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional SMTP configuration for Wednesday CodeChef Starters reminders only.
# Signup and login do not require SMTP or email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Gemini model override for AI-powered modules
GEMINI_MODEL=gemini-2.5-flash
